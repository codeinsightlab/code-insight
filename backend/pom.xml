<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.0</version>
        <relativePath/>
    </parent>

    <groupId>lab.codeinsight</groupId>
    <artifactId>code-insight-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>code-insight-backend</name>
    <description>Multi-module backend for CodeInsight</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <modules>
        <module>code-insight-model</module>
        <module>code-insight-dal</module>
        <module>code-insight-main</module>
        <module>code-insight-web</module>
        <module>code-insight-boot</module>
    </modules>
</project>
